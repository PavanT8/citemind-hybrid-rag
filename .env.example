# ==============================================================================
# CiteMind Hybrid RAG - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit your actual .env file with secrets to version control.
# ==============================================================================

# LLM & Embedding Provider ("gemini" or "lmstudio")
LLM_PROVIDER=gemini

# Google Gemini API Settings (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# LM Studio Settings (For 100% offline local development: http://localhost:1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=not-needed

# Backend Server & CORS Configuration
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Evaluation Settings
ENABLE_EVAL_LOGGING=true
FAITHFULNESS_THRESHOLD=0.70
